# Database
DATABASE_URL="postgresql://attendance:attendance@localhost:5432/attendance_db"

# NextAuth (v5 uses AUTH_SECRET; NEXTAUTH_SECRET is fallback)
AUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_SECRET="your-secret-key-change-in-production"
AUTH_URL="http://localhost:3000"

# QR Token Signing (defaults to AUTH_SECRET if missing)
QR_SIGNING_SECRET="your-qr-secret-key-change-in-production"
